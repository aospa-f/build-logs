<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Custom Frameworks and Settings (AOSPA calcite with pure black AMOLED, bypass charging, battery indicators) -->
  <remove-project name="AOSPA/android_frameworks_base" />
  <project path="frameworks/base" name="aospa-f/aospa_frameworks_base" revision="calcite" remote="github" />

  <remove-project name="AOSPA/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="aospa-f/aospa_packages_apps_Settings" revision="calcite" remote="github" />

  <!-- Cleaned AOSPA vendor (with LineageOS kernel build system & giulia product) -->
  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa" name="aospa-f/aospa_vendor_aospa" revision="calcite" remote="github">
    <linkfile src="build.sh" dest="rom-build.sh" />
  </project>

  <!-- Debloated GMS (Game Dashboard disabled; Maps included; YouTube, Photos, Drive, Chrome removed) -->
  <remove-project name="android_vendor_google_gms" />
  <project path="vendor/google/gms" name="aospa-f/android_vendor_google_gms" revision="calcite" remote="github" clone-depth="1" />

  <!-- Native Frameworks and Sepolicy from aospa-f -->
  <remove-project name="AOSPA/android_frameworks_av" />
  <project path="frameworks/av" name="aospa-f/aospa_frameworks_av" revision="calcite" remote="github" />

  <remove-project name="AOSPA/android_frameworks_native" />
  <project path="frameworks/native" name="aospa-f/aospa_frameworks_native" revision="calcite" remote="github" />

  <remove-project name="AOSPA/android_device_qcom_sepolicy_vndr" />
  <project path="device/qcom/sepolicy_vndr" name="aospa-f/aospa_device_qcom_sepolicy_vndr" revision="calcite" remote="github" />

  <remove-project name="platform/system/sepolicy" />
  <project path="system/sepolicy" name="aospa-f/aospa_system_sepolicy" revision="calcite" remote="github" />

  <!-- Device Trees (Synchronized in aospa-f) -->
  <project path="device/oneplus/giulia" name="aospa-f/device_oneplus_giulia" revision="calcite" remote="github" />
  <project path="device/oneplus/sm8650-common" name="aospa-f/device_oneplus_sm8650-common" revision="calcite" remote="github" />

  <!-- Proprietary Vendor Trees & Latest OxygenOS 16 Firmware from TheMuppets (lineage-23.2: OOS 11.F.58 / 11.F.53) -->
  <project path="vendor/oneplus/giulia" name="TheMuppets/proprietary_vendor_oneplus_giulia" revision="lineage-23.2" remote="github" />
  <project path="vendor/oneplus/sm8650-common" name="TheMuppets/proprietary_vendor_oneplus_sm8650-common" revision="lineage-23.2" remote="github" />

  <!-- Qualcomm Common Proprietary Blobs from ThankYouMario (AOSPA calcite) -->
  <remove-project name="proprietary_vendor_qcom_common" />
  <project path="vendor/qcom/common" name="ThankYouMario/proprietary_vendor_qcom_common" revision="calcite" remote="github" />

  <!-- Remove Qualcomm FM radio (Not present on OnePlus 13R / SM8650) -->
  <remove-project name="platform/vendor/qcom-opensource/fm-commonsys" />

  <!-- LineageOS Kernel Build System & Toolchains -->
  <remove-project name="AOSPA/android_kernel_build" />

  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="github" />
  <project path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="github" />
  <project path="prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_x86_x86_64-linux-android-4.9" groups="pdk,linux,x86" clone-depth="1" revision="lineage-19.1" remote="github" />
  <project path="prebuilts/kernel-build-tools" name="kernel/prebuilts/build-tools" clone-depth="1" remote="aosp" revision="main-kernel-2025" />
  <project path="prebuilts/tools-lineage" name="LineageOS/android_prebuilts_tools-lineage" clone-depth="1" revision="lineage-23.2" remote="github" />

  <!-- Kernel & Devicetrees & Modules (Synchronized in aospa-f) -->
  <project path="kernel/oneplus/sm8650" name="aospa-f/kernel_oneplus_sm8650" revision="calcite" remote="github" />
  <project path="kernel/oneplus/sm8650-devicetrees" name="aospa-f/kernel_oneplus_sm8650-devicetrees" revision="calcite" remote="github" />
  <project path="kernel/oneplus/sm8650-modules" name="aospa-f/kernel_oneplus_sm8650-modules" revision="calcite" remote="github" />

  <!-- Hardware & Services (Synchronized in aospa-f) -->
  <project path="hardware/oplus" name="aospa-f/hardware_oplus" revision="calcite" remote="github" />

  <!-- Proprietary Blobs (Camera, Audio, IR) -->
  <project path="vendor/oneplus/ir" name="aosp-for-giulia/vendor_oneplus_ir" revision="16" remote="github" />
  <project path="vendor/sony/dolby" name="aosp-for-giulia/proprietary_vendor_sony_dolby" revision="16" remote="github" />
  <project path="packages/apps/LunarisDolby" name="aosp-for-giulia/android_packages_apps_LunarisDolby" revision="16" remote="github" />
  <project path="vendor/oplus/camera" name="aospa-f/vendor_oplus_camera" revision="calcite" remote="github" />

  <!-- Bypass Charging (aospa-f with unplug broadcast receiver & battery indicators) -->
  <project path="packages/apps/BypassCharge" name="aospa-f/packages_apps_BypassCharge" revision="sixteen" remote="github" />

  <!-- Vibrator Features from YAAP -->
  <remove-project name="AOSPA/android_vendor_qcom-opensource_vibrator" />
  <project path="vendor/qcom/opensource/vibrator" name="yaap/vendor_qcom_opensource_vibrator" revision="seventeen" remote="github">
    <linkfile dest="vendor/qcom/defs/product-defs/vendor/vibrator_product.mk" src="vibrator-vendor-product.mk"/>
  </project>
</manifest>
