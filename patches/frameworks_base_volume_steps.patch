From afce17a37e703d2d87a61308d18f056b2195b8b7 Mon Sep 17 00:00:00 2001
From: raizenftw <raizen.mad@gmail.com>
Date: Sun, 1 Nov 2026 16:25:47 +0000
Subject: [PATCH] core: Increase ring and notification volume steps to 10

Change-Id: Ie06b51f491df5cbfb36380e0f64c4865710a878b
---
 core/res/res/values/config.xml | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/core/res/res/values/config.xml b/core/res/res/values/config.xml
index e6c5b11945c1c..d58a6fbb2d133 100644
--- a/core/res/res/values/config.xml
+++ b/core/res/res/values/config.xml
@@ -2419,16 +2419,16 @@
     <bool name="config_volume_up_to_exit_silent">false</bool>
 
     <!-- The number of volume steps for the notification stream -->
-    <integer name="config_audio_notif_vol_steps">7</integer>
+    <integer name="config_audio_notif_vol_steps">10</integer>
 
     <!-- The default volume for the notification stream -->
-    <integer name="config_audio_notif_vol_default">5</integer>
+    <integer name="config_audio_notif_vol_default">7</integer>
 
     <!-- The number of volume steps for the ring stream -->
-    <integer name="config_audio_ring_vol_steps">7</integer>
+    <integer name="config_audio_ring_vol_steps">10</integer>
 
     <!-- The default volume for the ring stream -->
-    <integer name="config_audio_ring_vol_default">5</integer>
+    <integer name="config_audio_ring_vol_default">7</integer>
 
     <!-- The default min volume for the alarm stream -->
     <integer name="config_audio_alarm_min_vol">1</integer>
-- 
2.43.0

