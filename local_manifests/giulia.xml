<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!--
    OnePlus 13R (giulia / SM8650) Local Manifest Additions & Overrides
    Primary Manifest: https://github.com/aospa-f/manifest (calcite branch)

    Note: aospa-f/manifest ALREADY includes:
      - frameworks/base, packages/apps/Settings, vendor/aospa, vendor/google/gms
      - frameworks/av, frameworks/native, system/sepolicy, device/qcom/sepolicy_vndr
      - device/oneplus/giulia, device/oneplus/sm8650-common
      - kernel/oneplus/sm8650 (and devicetrees, modules)
      - hardware/oplus, packages/apps/BypassCharge, vendor/oplus/camera
      - vendor/oneplus/ir, vendor/sony/dolby, packages/apps/LunarisDolby
      - vendor/qcom/opensource/vibrator (yaap seventeen)
      - prebuilts/kernel-build-tools, prebuilts/tools-lineage
    DO NOT redeclare any of the above here or repo will error with duplicate path!
  -->

  <!-- Proprietary Vendor Trees from TheMuppets (lineage-23.2: OxygenOS 16 base) -->
  <project path="vendor/oneplus/giulia" name="TheMuppets/proprietary_vendor_oneplus_giulia" revision="lineage-23.2" remote="github" />
  <project path="vendor/oneplus/sm8650-common" name="TheMuppets/proprietary_vendor_oneplus_sm8650-common" revision="lineage-23.2" remote="github" />

  <!-- Qualcomm Common Proprietary Blobs: Override oplus-8650-clo with ThankYouMario -->
  <remove-project name="oplus-8650-clo/proprietary_vendor_qcom_common" />
  <project path="vendor/qcom/common" name="ThankYouMario/proprietary_vendor_qcom_common" revision="calcite" remote="github" />

  <!-- Prebuilt GCC Toolchains for LineageOS Kernel Build System -->
  <project path="prebuilts/gcc/linux-x86/aarch64/aarch64-linux-android-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_aarch64_aarch64-linux-android-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="github" />
  <project path="prebuilts/gcc/linux-x86/arm/arm-linux-androideabi-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_arm_arm-linux-androideabi-4.9" groups="pdk,linux,arm" clone-depth="1" revision="lineage-19.1" remote="github" />
  <project path="prebuilts/gcc/linux-x86/x86/x86_64-linux-android-4.9" name="LineageOS/android_prebuilts_gcc_linux-x86_x86_x86_64-linux-android-4.9" groups="pdk,linux,x86" clone-depth="1" revision="lineage-19.1" remote="github" />
</manifest>
