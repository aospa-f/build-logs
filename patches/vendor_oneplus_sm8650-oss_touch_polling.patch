From d8dc6cfb3cf2c08922acf12e1e30ce5205008146 Mon Sep 17 00:00:00 2001
From: raizenftw <raizen.mad@gmail.com>
Date: Sun, 8 Nov 2026 14:28:44 +0000
Subject: [PATCH] touch: Implement Synaptics TCM HBP report rate control and
 init trigger

- Control report rate via synaptics_tcm_hbp.0/high_rate sysfs node on SM8650
- Start polling thread immediately in OplusTouch constructor
- Switch to debug.touch_polling_mode to avoid libc property denials
- Add init property triggers in .rc file for instant hardware switching
---
 .../OplusTouch.cpp                            | 61 +++++++++++++++----
 .../OplusTouch.h                              |  3 +-
 .../vendor-oplus-hardware-touch-V2-service.rc |  6 ++
 3 files changed, 58 insertions(+), 12 deletions(-)

diff --git a/vendor.oplus.hardware.touch@2.0-service/OplusTouch.cpp b/vendor.oplus.hardware.touch@2.0-service/OplusTouch.cpp
index b59d7a0..7e54e6b 100644
--- a/vendor.oplus.hardware.touch@2.0-service/OplusTouch.cpp
+++ b/vendor.oplus.hardware.touch@2.0-service/OplusTouch.cpp
@@ -140,14 +140,37 @@ int32_t writeFile(const std::string& path, const std::string& data) {
 }
 
 constexpr int32_t kReportRateNode = 182;
-constexpr const char* kTouchPollingProp = "persist.touch_polling_mode";
+constexpr const char* kTouchPollingProp = "debug.touch_polling_mode";
+constexpr const char* kTouchPollingStateFile = "/data/vendor/touch/touch_polling_enabled";
+constexpr const char* kHighRateSysfsPath =
+    "/sys/bus/platform/drivers/synaptics_tcm_hbp/synaptics_tcm_hbp.0/high_rate";
+constexpr const char* kHighRateAltSysfsPath =
+    "/sys/devices/platform/soc/ac0000.qcom,qupv3_1_geni_se/a90000.spi/spi_master/spi0/spi0.0/synaptics_tcm_hbp.0/high_rate";
 
 void applyTouchPollingRate(OplusTouch* touch) {
     const std::string value = android::base::GetProperty(kTouchPollingProp, "0");
     const std::string payload = (value == "1") ? "1" : "0";
+
+    // Try Synaptics TCM HBP high_rate sysfs node first (OnePlus 13R / SM8650)
+    int fd = ::open(kHighRateSysfsPath, O_WRONLY | O_CLOEXEC);
+    if (fd < 0) {
+        fd = ::open(kHighRateAltSysfsPath, O_WRONLY | O_CLOEXEC);
+    }
+    if (fd >= 0) {
+        ssize_t written = ::write(fd, payload.c_str(), payload.size());
+        ::close(fd);
+        if (written > 0) {
+            LOG(INFO) << "applied touch polling rate to synaptics high_rate: " << payload;
+            writeFile(kTouchPollingStateFile, payload);
+            return;
+        }
+    }
+
+    // Fallback to legacy report_rate procfs node
     int32_t result = touch->writeNodeFile(0, kReportRateNode, payload);
     if (result >= 0) {
-        LOG(INFO) << "applied touch polling rate: " << payload;
+        LOG(INFO) << "applied touch polling rate to node 182: " << payload;
+        writeFile(kTouchPollingStateFile, payload);
     } else {
         LOG(WARNING) << "failed to apply touch polling rate: " << payload;
     }
@@ -155,27 +178,43 @@ void applyTouchPollingRate(OplusTouch* touch) {
 
 }  // namespace
 
+OplusTouch::OplusTouch() {
+    startPollingWatcher();
+}
+
 OplusTouch::~OplusTouch() {
     mShutdown.store(true);
 }
 
-ndk::ScopedAStatus OplusTouch::initialize(OplusTouchStatus* _aidl_return) {
-    LOG(INFO) << "oplus touch source service initializing";
+void OplusTouch::startPollingWatcher() {
+    // Restore persisted state from file if property is unset on boot
+    std::string savedState;
+    if (readFile(kTouchPollingStateFile, 4, &savedState) > 0 && !savedState.empty()) {
+        const std::string initialVal = (savedState[0] == '1') ? "1" : "0";
+        if (android::base::GetProperty(kTouchPollingProp, "").empty()) {
+            android::base::SetProperty(kTouchPollingProp, initialVal);
+        }
+    }
 
-    // Apply the user-chosen touch polling rate immediately and watch the
-    // setting property so the toggle in Settings takes effect without a reboot.
     applyTouchPollingRate(this);
+
     std::thread([this]() {
-        std::string lastValue = android::base::GetProperty(kTouchPollingProp, "0");
+        std::string lastValue = "";
         while (!mShutdown.load()) {
-            std::this_thread::sleep_for(std::chrono::seconds(2));
-            const std::string value = android::base::GetProperty(kTouchPollingProp, "0");
-            if (value != lastValue) {
-                lastValue = value;
+            std::this_thread::sleep_for(std::chrono::milliseconds(500));
+            std::string curVal = android::base::GetProperty(kTouchPollingProp, "0");
+            if (curVal != lastValue) {
+                lastValue = curVal;
                 applyTouchPollingRate(this);
             }
         }
     }).detach();
+}
+
+ndk::ScopedAStatus OplusTouch::initialize(OplusTouchStatus* _aidl_return) {
+    LOG(INFO) << "oplus touch source service initializing";
+
+    applyTouchPollingRate(this);
 
     if (_aidl_return != nullptr) {
         *_aidl_return = OplusTouchStatus::OK;
diff --git a/vendor.oplus.hardware.touch@2.0-service/OplusTouch.h b/vendor.oplus.hardware.touch@2.0-service/OplusTouch.h
index 501a039..5ba4017 100644
--- a/vendor.oplus.hardware.touch@2.0-service/OplusTouch.h
+++ b/vendor.oplus.hardware.touch@2.0-service/OplusTouch.h
@@ -22,7 +22,7 @@ namespace aidl::vendor::oplus::hardware::touch {
 
 class OplusTouch : public BnOplusTouch {
   public:
-    OplusTouch() = default;
+    OplusTouch();
     ~OplusTouch() override;
 
     ndk::ScopedAStatus initialize(OplusTouchStatus* _aidl_return) override;
@@ -59,6 +59,7 @@ class OplusTouch : public BnOplusTouch {
     int32_t writeNodeFile(int32_t deviceId, int32_t nodeFlag, const std::string& info);
 
   private:
+    void startPollingWatcher();
 
     // The HBP kernel does not expose the legacy double_tap_enable_indep proc
     // node. Keep the AIDL node contract usable by exposing the gesture mask
diff --git a/vendor.oplus.hardware.touch@2.0-service/etc/vendor-oplus-hardware-touch-V2-service.rc b/vendor.oplus.hardware.touch@2.0-service/etc/vendor-oplus-hardware-touch-V2-service.rc
index 8d47513..c2b3fa5 100644
--- a/vendor.oplus.hardware.touch@2.0-service/etc/vendor-oplus-hardware-touch-V2-service.rc
+++ b/vendor.oplus.hardware.touch@2.0-service/etc/vendor-oplus-hardware-touch-V2-service.rc
@@ -68,3 +68,9 @@ on post-fs-data
     mkdir /data/vendor/touch/simulate 0771 system system
     mkdir /data/vendor/touch/upload 0771 system system
     write /proc/sys/kernel/firmware_config/force_sysfs_fallback 1
+
+on property:debug.touch_polling_mode=1
+    write /sys/bus/platform/drivers/synaptics_tcm_hbp/synaptics_tcm_hbp.0/high_rate 1
+
+on property:debug.touch_polling_mode=0
+    write /sys/bus/platform/drivers/synaptics_tcm_hbp/synaptics_tcm_hbp.0/high_rate 0
