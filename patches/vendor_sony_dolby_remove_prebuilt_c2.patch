From d323cea05521d6bf71e0feafdb70490ef1bbf95e Mon Sep 17 00:00:00 2001
From: raizenftw <raizen.mad@gmail.com>
Date: Mon, 2 Nov 2026 19:30:06 +0000
Subject: [PATCH] dolby: Drop the prebuilt C2 service

The C2 service is now built from AOSPA source in
device/oneplus/giulia/dolby. Remove the stock service binary and its
prebuilt module while keeping the Dolby store and the existing init/VINTF
files.

Signed-off-by: raizenftw <raizen.mad@gmail.com>
---
 Android.bp                                    |  41 +-----------------
 proprietary-files.txt                         |   1 -
 .../bin/hw/vendor.dolby.media.c2@1.0-service  | Bin 11488 -> 0 bytes
 3 files changed, 2 insertions(+), 40 deletions(-)
 delete mode 100755 proprietary/vendor/bin/hw/vendor.dolby.media.c2@1.0-service

diff --git a/Android.bp b/Android.bp
index 2bffadd..77bc899 100644
--- a/Android.bp
+++ b/Android.bp
@@ -637,42 +637,5 @@ cc_prebuilt_binary {
     soc_specific: true,
 }
 
-cc_prebuilt_binary {
-    name: "vendor.dolby.media.c2@1.0-service",
-    owner: "sony",
-    target: {
-        android_arm64: {
-            srcs: [
-                "proprietary/vendor/bin/hw/vendor.dolby.media.c2@1.0-service",
-            ],
-            shared_libs: [
-                "libbase",
-                "liblog",
-                "libcodec2",
-                "libutils",
-                "android.hardware.media.c2@1.0",
-                "android.hardware.media.c2@1.1",
-                "android.hardware.media.c2@1.2",
-                "libcodec2_hidl@1.0",
-                "libcodec2_hidl@1.1",
-                "libcodec2_hidl@1.2",
-                "libcodec2_vndk",
-                "libhidlbase",
-                "libavservices_minijail",
-                "libbinder",
-                "libcodec2_store_dolby",
-                "libc++",
-                "libc",
-                "libm",
-                "libdl",
-            ],
-        },
-    },
-    compile_multilib: "64",
-    strip: {
-        none: true,
-    },
-    prefer: true,
-    relative_install_path: "hw",
-    soc_specific: true,
-}
+// vendor.dolby.media.c2@1.0-service is built from AOSPA source in
+// device/oneplus/giulia/dolby; it links the stock libcodec2_store_dolby.
diff --git a/proprietary-files.txt b/proprietary-files.txt
index f1833df..cbca611 100644
--- a/proprietary-files.txt
+++ b/proprietary-files.txt
@@ -4,7 +4,6 @@
 # libswdap are pinned from XQ-DQ72_Customized-SEA_67.2.A.3.141
 
 vendor/bin/hw/vendor.dolby.hardware.dms@2.0-service
-vendor/bin/hw/vendor.dolby.media.c2@1.0-service
 vendor/etc/init/vendor.dolby.hardware.dms@2.0-service.rc
 vendor/etc/init/vendor.dolby.media.c2@1.0-service.rc
 vendor/etc/vintf/manifest/vendor.dolby.hardware.dms.xml
diff --git a/proprietary/vendor/bin/hw/vendor.dolby.media.c2@1.0-service b/proprietary/vendor/bin/hw/vendor.dolby.media.c2@1.0-service
deleted file mode 100755
index c3254789be37daa3b731067058dad11ad09c4099..0000000000000000000000000000000000000000
GIT binary patch
