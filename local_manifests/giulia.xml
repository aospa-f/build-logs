<?xml version="1.0" encoding="UTF-8"?>
<manifest>
  <!-- Custom Frameworks and Settings (AOSPA calcite with pure black AMOLED, silent gestures, clock & speed meter) -->
  <remove-project name="AOSPA/android_frameworks_base" />
  <project path="frameworks/base" name="dyruz10/android_frameworks_base" revision="calcite" remote="github" />

  <remove-project name="AOSPA/android_packages_apps_Settings" />
  <project path="packages/apps/Settings" name="dyruz10/android_packages_apps_Settings" revision="calcite" remote="github" />

  <!-- Cleaned AOSPA vendor (with LineageOS kernel build system & giulia product) -->
  <remove-project name="AOSPA/android_vendor_aospa" />
  <project path="vendor/aospa" name="dyruz10/android_vendor_aospa" revision="calcite" remote="github">
    <linkfile src="build.sh" dest="rom-build.sh" />
  </project>

  <!-- Debloated GMS (Maps included; YouTube, Photos, Drive, Chrome, Auto, FamilyLink, TalkBack, Files removed) -->
  <remove-project name="android_vendor_google_gms" />
  <project path="vendor/google/gms" name="dyruz10/android_vendor_google_gms" revision="calcite" remote="github" clone-depth="1" />

  <!-- Build System & Native Framework Patches from clo-for-giulia -->
  <remove-project name="AOSPA/android_build" />
  <project path="build/make" name="clo-for-giulia/build_make" revision="celerity" remote="github">
    <linkfile src="CleanSpec.mk" dest="build/CleanSpec.mk" />
    <linkfile src="buildspec.mk.default" dest="build/buildspec.mk.default" />
    <linkfile src="core" dest="build/core" />
    <linkfile src="envsetup.sh" dest="build/envsetup.sh" />
    <linkfile src="target" dest="build/target" />
    <linkfile src="tools" dest="build/tools" />
  </project>

  <remove-project name="AOSPA/android_build_soong" />
  <project path="build/soong" name="clo-for-giulia/build_soong" revision="celerity" remote="github">
    <linkfile src="root.bp" dest="Android.bp" />
    <linkfile src="bootstrap.bash" dest="bootstrap.bash" />
  </project>

  <remove-project name="AOSPA/android_frameworks_av" />
  <project path="frameworks/av" name="clo-for-giulia/frameworks_av" revision="celerity" remote="github" />

  <remove-project name="AOSPA/android_frameworks_native" />
  <project path="frameworks/native" name="clo-for-giulia/android_frameworks_native" revision="celerity" remote="github" />

  <remove-project name="AOSPA/android_device_qcom_sepolicy_vndr" />
  <project path="device/qcom/sepolicy_vndr" name="clo-for-giulia/android_device_qcom_sepolicy_vndr" revision="celerity" remote="github" />

  <remove-project name="proprietary_vendor_qcom_common" />
  <project path="vendor/qcom/common" name="clo-for-giulia/vendor_qcom_common" revision="celerity" remote="github" />

  <remove-project name="AOSPA/android_device_qcom_common" />
  <project path="device/qcom/common" name="clo-for-giulia/device_qcom_common" revision="celerity" remote="github" />

  <!-- Device Trees (Synchronized in dyruz10 with all latest clo-for-giulia commits) -->
  <project path="device/oneplus/giulia" name="dyruz10/android_device_oneplus_giulia" revision="calcite" remote="github" />
  <project path="device/oneplus/sm8650-common" name="dyruz10/android_device_oneplus_sm8650-common" revision="calcite" remote="github" />

  <!-- Proprietary Vendor Trees (Pre-extracted firmware, radio, and device blobs) -->
  <project path="vendor/oneplus/giulia" name="TheMuppets/proprietary_vendor_oneplus_giulia" revision="lineage-23.2" remote="github" />
  <project path="vendor/oneplus/sm8650-common" name="TheMuppets/proprietary_vendor_oneplus_sm8650-common" revision="lineage-24.0" remote="github" />

  <!-- Lineage Kernel & Devicetrees & Modules (Synchronized in dyruz10) -->
  <project path="kernel/oneplus/sm8650" name="dyruz10/android_kernel_oneplus_sm8650" revision="celerity" remote="github" />
  <project path="kernel/oneplus/sm8650-devicetrees" name="clo-for-giulia/android_kernel_oneplus_sm8650-devicetrees" revision="celerity" remote="github" />
  <project path="kernel/oneplus/sm8650-modules" name="clo-for-giulia/android_kernel_oneplus_sm8650-modules" revision="celerity" remote="github" />

  <!-- Hardware & Services (Synchronized in dyruz10) -->
  <project path="hardware/oplus" name="dyruz10/android_hardware_oplus" revision="calcite" remote="github" />
  <remove-project name="AOSPA/android_hardware_qcom_thermal" />
  <project path="vendor/qcom/opensource/thermal-hal" name="clo-for-giulia/android_hardware_qcom_thermal" revision="celerity" remote="github" />
  <project path="vendor/qcom/opensource/libvmmem" name="clo-for-giulia/android_vendor_qcom_opensource_libvmmem" revision="celerity" remote="github" />
  <project path="vendor/custom-preference" name="dyruz10/vendor_custom-preference" revision="celerity" remote="github" />

  <!-- Proprietary Blobs (Camera, Audio, IR) -->
  <project path="vendor/oneplus/ir" name="clo-for-giulia/vendor_oneplus_ir" revision="celerity" remote="github" />
  <project path="vendor/sony/dolby" name="clo-for-giulia/proprietary_vendor_sony_dolby" revision="celerity" remote="github" />
  <project path="packages/apps/LunarisDolby" name="clo-for-giulia/android_packages_apps_LunarisDolby" revision="celerity" remote="github" />

  <!-- Power & Vibrator Features from YAAP -->
  <project path="packages/apps/BypassCharge" name="yaap/packages_apps_BypassCharge" revision="sixteen" remote="github" />
  <remove-project name="AOSPA/android_vendor_qcom-opensource_vibrator" />
  <project path="vendor/qcom/opensource/vibrator" name="yaap/vendor_qcom_opensource_vibrator" revision="sixteen" remote="github" />

  <!-- PenguinOS Dialer (Glass UI, iOS layout, Aurora in-call background) -->
  <remove-project name="platform/packages/apps/Dialer" />
  <project path="packages/apps/Dialer" name="Project-PenguinOS/penguin_packages_apps_Dialer" revision="celerity" remote="github" />
</manifest>
